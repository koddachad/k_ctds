+/**
+ * Set a federated authentication (Entra ID) access token.
+ * When set, TDS 7.4+ logins use the FEDAUTH SecurityToken library
+ * instead of user name/password or integrated authentication.
+ */
+bool
+tds_set_fedauth_token(TDSLOGIN * tds_login, const char *token)
+{
+	tds_dstr_zero(&tds_login->fedauth_token);
+	return !!tds_dstr_copy(&tds_login->fedauth_token, token ? token : "");
+}
